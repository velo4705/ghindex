# Dependencies
node_modules/

# M0 spike artifacts: the feasibility investigation. Kept for provenance in
# spike/, but the raw JSON dumps are large and regenerable.
spike/data/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local env
.env
.env.local

# Cloudflare Wrangler. `.wrangler/` is local dev state; `.dev.vars` is the
# secrets file `wrangler dev` reads. The deployed GitHub token belongs in the
# worker's own secret store, never in a file here — see worker/wrangler.jsonc.
.wrangler/
.dev.vars

# Agent tooling. Note this only affects untracked files: anything already
# committed under here stays tracked until `git rm --cached`.
.opencode/
